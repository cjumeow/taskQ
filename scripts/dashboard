#!/usr/bin/env bash
# Live terminal view of queue state, refreshed every second. Ctrl+C to quit.
# Usage: ./scripts/dashboard
#        ./scripts/dashboard --once   (print one snapshot and exit)
set -euo pipefail

cd "$(dirname "$0")/.."
rc() { docker compose exec -T redis redis-cli "$@"; }

# Indent each line, or print (empty) when there is no output
list() { sed '/^$/d; s/^/  /' | grep . || echo "  (empty)"; }

# Remaining lease time per task, computed with Redis server time
LEASE_LUA="local now = redis.call('TIME')
local now_s = tonumber(now[1]) + tonumber(now[2]) / 1000000
local r = redis.call('ZRANGE', KEYS[1], 0, -1, 'WITHSCORES')
local out = {}
for i = 1, #r, 2 do
  out[#out + 1] = string.format('%-28s expires in %5.1fs', r[i], tonumber(r[i + 1]) - now_s)
end
return out"

snapshot() {
  echo "taskQ dashboard  $(date +%T)"
  echo
  echo "ready=$(rc LLEN queue:ready)  leased=$(rc ZCARD queue:leased)"
  echo
  echo "[queue:ready] (right end is leased next)"
  rc LRANGE queue:ready 0 -1 | list
  echo
  echo "[queue:leased]"
  rc EVAL "$LEASE_LUA" 1 queue:leased | list
  echo
  echo "[tasks] state / attempts / worker"
  for k in $(rc --scan --pattern 'task:*' | sort); do
    printf '%-34s %s\n' "$k" "$(rc HMGET "$k" state attempts worker | paste -sd' ' -)"
  done | list
}

if [ "${1:-}" = "--once" ]; then
  snapshot
  exit 0
fi

while true; do
  out="$(snapshot)"
  clear
  echo "$out"
  sleep 1
done
